require "shellwords"
require "tempfile"
require_relative "release_config"

opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build, automatically sign and upload Saku to TestFlight"
  lane :beta do
    credentials = SakuRelease.credentials
    api_key = app_store_connect_api_key(
      key_id: credentials.fetch(:key_id),
      issuer_id: credentials.fetch(:issuer_id),
      key_content: credentials.fetch(:key),
      duration: 1200,
      in_house: false
    )

    root = File.expand_path("../../..", __dir__)
    Dir.chdir(root) { sh("npm run build && npx cap sync ios") }
    project = File.join(root, "ios/App/App.xcodeproj")
    version = get_version_number(xcodeproj: project, target: "App")
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "id.saku.app",
      version: version,
      initial_build_number: 0
    ) + 1

    Tempfile.create(["saku-asc-", ".p8"]) do |key_file|
      key_file.write(credentials.fetch(:key))
      key_file.flush
      signing_args = Shellwords.join([
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_file.path,
        "-authenticationKeyID", credentials.fetch(:key_id),
        "-authenticationKeyIssuerID", credentials.fetch(:issuer_id)
      ])
      ipa = build_app(
        project: project,
        scheme: "App",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        skip_profile_detection: true,
        export_team_id: credentials.fetch(:team_id),
        export_options: {
          signingStyle: "automatic",
          teamID: credentials.fetch(:team_id),
          manageAppVersionAndBuildNumber: false
        },
        xcargs: "#{signing_args} #{Shellwords.join([
          "DEVELOPMENT_TEAM=#{credentials.fetch(:team_id)}",
          "CODE_SIGN_STYLE=Automatic",
          "CURRENT_PROJECT_VERSION=#{build_number}"
        ])}",
        export_xcargs: signing_args,
        output_directory: File.join(root, "ios/App/output"),
        output_name: "Saku.ipa"
      )
      upload_to_testflight(
        api_key: api_key,
        app_identifier: "id.saku.app",
        ipa: ipa,
        skip_waiting_for_build_processing: true
      )
    end
  end
end
